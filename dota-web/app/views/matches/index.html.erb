<div>
  <h1 style="font-size: 2rem; margin-bottom: 2rem; font-weight: bold;">Match History</h1>

  <% if flash[:alert].present? %>
    <div style="margin-bottom: 1rem; padding: 0.75rem 1rem; border: 1px solid #ff6b6b; color: #ff6b6b;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div style="border: 1px solid #ffffff;">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="border-bottom: 1px solid #ffffff;">
          <th style="padding: 1rem; text-align: left; border-right: 1px solid #ffffff;">Match ID</th>
          <th style="padding: 1rem; text-align: left; border-right: 1px solid #ffffff;">Hero</th>
          <th style="padding: 1rem; text-align: left; border-right: 1px solid #ffffff;">Result</th>
          <th style="padding: 1rem; text-align: left; border-right: 1px solid #ffffff;">Duration</th>
          <th style="padding: 1rem; text-align: left; border-right: 1px solid #ffffff;">K/D/A</th>
          <th style="padding: 1rem; text-align: left; border-right: 1px solid #ffffff;">Started</th>
          <th style="padding: 1rem; text-align: left;">Link</th>
        </tr>
      </thead>
      <tbody>
        <% @matches.each do |match| %>
          <tr style="border-bottom: 1px solid #ffffff;">
            <td style="padding: 1rem; border-right: 1px solid #ffffff;"><%= match[:id] %></td>
            <td style="padding: 1rem; border-right: 1px solid #ffffff;">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <%= dota_named_image_tag(match[:hero_name], folders: ["hero_icons"], alt: match[:hero_name], style: "width: 56px; height: 32px; object-fit: cover; border: 1px solid #333;") %>
                <div><%= match[:hero_name] %></div>
              </div>
            </td>
            <td style="padding: 1rem; border-right: 1px solid #ffffff;"><%= match[:result] %></td>
            <td style="padding: 1rem; border-right: 1px solid #ffffff;"><%= match[:duration] || "-" %></td>
            <td style="padding: 1rem; border-right: 1px solid #ffffff;"><%= match[:kda] || "-" %></td>
            <td style="padding: 1rem; border-right: 1px solid #ffffff;">
              <% if match[:start_time].present? %>
                <% started_at_utc = Time.at(match[:start_time].to_i).utc %>
                <span data-localize-utc data-epoch="<%= match[:start_time].to_i %>">
                  <%= started_at_utc.strftime("%Y-%m-%d %H:%M UTC") %>
                </span>
                (<%= time_ago_in_words(started_at_utc) %> ago)
              <% else %>
                -
              <% end %>
            </td>
            <td style="padding: 1rem;">
              <%= link_to "View", match_path(match[:id], playerid: params[:playerid]), style: "color: #ffffff; text-decoration: underline;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
