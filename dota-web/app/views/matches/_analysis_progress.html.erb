<% if dota_match&.analysis_in_progress? %>
  <style>
    .analysis-progress-spinner {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      border: 2px solid rgba(255,255,255,0.25);
      border-top-color: #ffffff;
      animation: analysis-progress-spin 0.8s linear infinite;
      display: inline-block;
    }

    @keyframes analysis-progress-spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <div style="border: 1px solid #ffffff; padding: 1rem 1.25rem; margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem;">
      <h2 style="font-size: 1.1rem; margin: 0; font-weight: bold;">Analysis progress</h2>
      <div style="display: inline-flex; align-items: center; gap: 0.45rem; opacity: 0.9;">
        <span class="analysis-progress-spinner" aria-hidden="true"></span>
        <span><%= dota_match.analysis_status_label %></span>
      </div>
    </div>

    <div style="height: 10px; border: 1px solid rgba(255,255,255,0.25); background: rgba(255,255,255,0.05);">
      <div style="height: 100%; width: <%= dota_match.analysis_progress_percent %>%; background: #228be6;"></div>
    </div>

    <div style="margin-top: 0.55rem; opacity: 0.8; font-size: 0.92rem;">
      <%= dota_match.analysis_status_message %>
    </div>
  </div>
<% end %>
